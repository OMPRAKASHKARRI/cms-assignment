# Root-level reference of every env var used across services.
# Each service also has its own .env.example inside its folder — copy those
# to .env before running `docker compose up`.

# ---- backend/.env ----
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://mongo:27017/renewcred_cms
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
SEED_ADMIN_EMAIL=admin@renewcred.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_USERNAME=admin

# ---- admin-frontend/.env ----
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ---- public-frontend/.env ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
